# ClaudeClang Doxygen 설정
# 사람 확인용 태그(CLAUDE.md 2.4)를 Doxygen이 인식하도록 ALIASES에 등록한다.
PROJECT_NAME           = "ClaudeClang"
INPUT                  = include src
RECURSIVE              = YES
FILE_PATTERNS          = *.c *.cpp *.h *.hpp
OUTPUT_DIRECTORY       = build/reports/doxygen
GENERATE_LATEX         = NO
GENERATE_HTML          = YES
QUIET                  = YES
EXTRACT_ALL            = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_INCOMPLETE_DOC = YES

ALIASES += "generated_by=@par Generated by:"
ALIASES += "generated_at=@par Generated at:"
ALIASES += "requested_by=@par Requested by:"
ALIASES += "human_review=@par Human review:"
ALIASES += "reviewed_by=@par Reviewed by:"
ALIASES += "reviewed_at=@par Reviewed at:"
ALIASES += "test=@par Test:"
ALIASES += "trace=@par Trace:"
ALIASES += "purpose=@par Purpose:"
ALIASES += "input=@par Input:"
ALIASES += "steps=@par Steps:"
ALIASES += "expect=@par Expected:"
