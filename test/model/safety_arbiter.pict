# safety_arbiter_decide 입력 조합 (동치 클래스: 값 3종 + INVALID + STALE)
# 기대 결과는 PICT가 만들지 않는다. test/unit/test_safety_arbiter_unit.cpp 의 오라클(요구사항 표)이 판단한다.
Crash:  NONE, PENDING, CONFIRMED, INVALID, STALE
AppL:   FALSE, TRUE, INVALID, STALE
AppR:   FALSE, TRUE, INVALID, STALE
Fault:  FALSE, TRUE, INVALID, STALE
Ign:    ON, OFF, INVALID, STALE
